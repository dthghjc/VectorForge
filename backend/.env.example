# ========================================
# VectorForge 环境变量配置示例
# ========================================
# 复制此文件为 .env 并根据你的环境修改相应的值
# 注意：.env 文件包含敏感信息，不要提交到版本控制系统

# ========== 项目基础配置 ==========
PROJECT_NAME=VectorForge
VERSION=0.1.0
DESCRIPTION=LLM对话标注审核与向量数据管理平台

# 运行环境: development, testing, production
ENVIRONMENT=development
DEBUG=false

# ========== FastAPI 服务配置 ==========
API_V1_STR=/v1
OPENAPI_VERSION=3.1.0

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 外部访问地址（可选，用于生成文档等）
# SERVER_EXTERNAL_URL=https://your-domain.com

# ========== 安全配置 ==========
# JWT 密钥（生产环境必须设置，至少32个字符）
# 开发环境如果不设置会自动生成临时密钥
SECRET_KEY=your-super-secret-key-here-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 邀请码（逗号分隔，可选）
INVITE_CODES=invite123,demo456,test789

# ========== 数据库配置 ==========
# 数据库类型: mysql, postgresql, sqlite
DATABASE_TYPE=mysql

# 数据库连接参数
DB_HOST=localhost
DB_PORT=3306
DB_USER=vectorforge
DB_PASSWORD=your-database-password
DB_NAME=vectorforge

# 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# 可选：直接指定完整数据库 URL（会覆盖上面的单独配置）
# DATABASE_URL=mysql+mysqlconnector://user:password@localhost:3306/vectorforge
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/vectorforge
# DATABASE_URL=sqlite:///./vectorforge.db

# ========== OpenAI 配置 ==========
# OpenAI API 密钥（必需）
OPENAI_API_KEY=sk-your-openai-api-key-here
# 自定义 API 基础 URL（可选，用于代理或其他兼容服务）
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Embedding 配置
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ========== Milvus 向量数据库配置 ==========
# Milvus 服务地址（可选）
# MILVUS_URI=http://localhost:19530
# Milvus 访问令牌（可选）
# MILVUS_TOKEN=your-milvus-token
MILVUS_DB_NAME=vectorforge
MILVUS_COLLECTION_PREFIX=vf_
MILVUS_SEARCH_TOP_K=10

# ========== 业务配置 ==========
# 内容限制
MAX_CONTENT_LENGTH=8192
MAX_CHAT_HISTORY=100

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB (字节)
ALLOWED_FILE_TYPES=txt,pdf,docx,json,csv

# 审核配置
AUTO_AUDIT_THRESHOLD=0.8
REQUIRE_MANUAL_REVIEW=true

# ========== 日志配置 ==========
LOG_LEVEL=INFO
# 日志文件路径（可选）
# LOG_FILE=logs/vectorforge.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ========== Redis 配置（可选） ==========
# 完整 Redis URL（可选）
# REDIS_URL=redis://localhost:6379/0
# 或者分别配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-redis-password

# ========== 开发配置 ==========
# 自动重载（仅开发环境）
RELOAD=false

# CORS 配置（逗号分隔的允许源）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ========== MinIO 对象存储配置（可选） ==========
# MinIO 服务地址
# MINIO_ENDPOINT=localhost:9000
# MinIO 访问凭证
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vectorforge
MINIO_SECURE=false

# ========================================
# 配置说明和示例
# ========================================

# 🔧 开发环境快速配置
# 最小配置，只需要设置这些：
# SECRET_KEY=dev-secret-key-32-characters-long
# DB_PASSWORD=dev-password
# OPENAI_API_KEY=sk-your-key

# 🚀 生产环境配置
# 生产环境必须设置的配置：
# ENVIRONMENT=production
# SECRET_KEY=production-secret-key-at-least-32-chars
# DB_PASSWORD=strong-production-password
# OPENAI_API_KEY=sk-production-openai-key
# SERVER_EXTERNAL_URL=https://your-production-domain.com

# 📊 数据库配置示例
# MySQL:
# DATABASE_TYPE=mysql
# DB_PORT=3306
# DATABASE_URL=mysql+mysqlconnector://user:pass@host:3306/db

# PostgreSQL:
# DATABASE_TYPE=postgresql  
# DB_PORT=5432
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/db

# SQLite (仅开发环境):
# DATABASE_TYPE=sqlite
# DATABASE_URL=sqlite:///./vectorforge.db

# 🔍 Milvus 向量数据库示例
# 本地 Milvus:
# MILVUS_URI=http://localhost:19530

# Zilliz Cloud:
# MILVUS_URI=https://your-cluster.zillizcloud.com:443
# MILVUS_TOKEN=your-zilliz-token

# 📁 MinIO 对象存储示例
# 本地 MinIO:
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# AWS S3 兼容:
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_ACCESS_KEY=your-aws-access-key
# MINIO_SECRET_KEY=your-aws-secret-key
# MINIO_SECURE=true

# 🌐 CORS 配置示例
# 开发环境:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 生产环境:
# CORS_ORIGINS=https://your-frontend.com,https://admin.your-domain.com

# 📝 日志配置示例
# 开发环境:
# LOG_LEVEL=DEBUG

# 生产环境:
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/vectorforge/app.log