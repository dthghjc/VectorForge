# ========== 项目基础配置 ==========
PROJECT_NAME=VectorForge
VERSION=0.1.0
DESCRIPTION=LLM对话标注审核与向量数据管理平台

# 运行环境: development, testing, production
ENVIRONMENT=development
DEBUG=false

# ========== FastAPI 服务配置 ==========
API_V1_STR=/v1
OPENAPI_VERSION=3.1.0

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# SERVER_EXTERNAL_URL=https://your-domain.com

# ========== 安全配置 ==========
# JWT 密钥（生产环境必须设置，至少32个字符）
SECRET_KEY=your-super-secret-key-here-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 邀请码（逗号分隔）
INVITE_CODES=invite123,demo456

# Dify API Keys（逗号分隔）
DIFY_API_KEYS=vf-your-api-key-1,vf-your-api-key-2

# ========== 数据库配置 ==========
# 数据库类型: mysql, postgresql, sqlite
DATABASE_TYPE=postgresql

# 数据库连接参数
DB_HOST=localhost
DB_PORT=5432
DB_USER=vectorforge
DB_PASSWORD=your-database-password
DB_NAME=vectorforge

# 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# 可选：直接指定完整数据库 URL
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/vectorforge

# ========== OpenAI 配置 ==========
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Embedding 配置
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ========== Milvus 配置 ==========
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=your-milvus-token
MILVUS_DB_NAME=vectorforge
MILVUS_COLLECTION_PREFIX=vf_
MILVUS_SEARCH_TOP_K=10

# ========== 业务配置 ==========
# 内容限制
MAX_CONTENT_LENGTH=8192
MAX_CHAT_HISTORY=100

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=txt,pdf,docx,json

# 审核配置
AUTO_AUDIT_THRESHOLD=0.8
REQUIRE_MANUAL_REVIEW=true

# ========== 日志配置 ==========
LOG_LEVEL=INFO
# LOG_FILE=logs/vectorforge.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ========== Redis 配置（可选） ==========
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-redis-password

# ========== 开发配置 ==========
RELOAD=false

# CORS 配置（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== MinIO 配置 ==========
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=vectorforge
MINIO_SECURE=false 